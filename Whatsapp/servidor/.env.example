# Servidor de WhatsApp de Neifert. Copiá este archivo como .env y completalo.
# Si corre dentro del repo, las credenciales de Supabase se toman del .env de la raíz
# y no hace falta repetirlas acá.

# Quién puede entrar
#   127.0.0.1 → solo esta PC (por defecto)
#   0.0.0.0   → también otras computadoras. Exige el login con el CRM.
HOST=127.0.0.1
PUERTO=3100

# Login con los usuarios del CRM (Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Nunca en el navegador ni con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dirección del CRM. Es el único sitio que puede mostrar el panel embebido, y adónde se
# manda al que abre el panel sin haber entrado desde el CRM.
CRM_URL=https://neifert.com.ar/crm/whatsapp

# Todo usuario activo del CRM entra con su nombre. Para limitarlo a algunos roles,
# listalos separados por coma (admin, dueno, vendedor).
# WHATSAPP_ROLES=admin,dueno

# Número de la concesionaria, con código de país. Cualquier usuario puede escanear el QR;
# si lo hace con otro número (su celular personal), se rechaza. Sin definir: cualquiera.
WHATSAPP_NUMERO=5493564562413

# Duración de la sesión del panel, en horas
SESION_HORAS=12
# Firma de la cookie. Si no se define se genera sola y se guarda en DATA_DIR.
# SESION_SECRETO=

# Base de datos de los mensajes (proyecto de Supabase del WhatsApp, esquema "wa").
# Supabase → Connect → Session pooler. También se acepta el nombre WA_SUPABASE_URL.
WA_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:CLAVE@aws-0-xx.pooler.supabase.com:5432/postgres

# Dónde se guardan chats, contactos y mensajes:
#   supabase → en la base de arriba (por defecto si WA_DATABASE_URL está definida)
#   local    → en archivos dentro de DATA_DIR. Solo para pruebas.
# ALMACEN=local

# Carpeta de la sesión de WhatsApp, de los archivos si no hay R2 (y de los mensajes en modo local).
DATA_DIR=data

# Archivos (fotos, videos, audios, stickers, documentos, fotos de perfil) en Cloudflare R2.
# El bucket tiene que ser PRIVADO; no uses el público del catálogo. Sin esta línea los
# archivos van a DATA_DIR. Ver docs/SERVIDOR.md, "Archivos en Cloudflare R2".
# WA_R2_BUCKET=neifert-whatsapp
# Endpoint y token: si no se definen, se usan los R2_* del .env del CRM.
# WA_R2_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# WA_R2_ACCESS_KEY_ID=
# WA_R2_SECRET_ACCESS_KEY=
