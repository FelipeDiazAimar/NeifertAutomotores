# Servidor de WhatsApp de Neifert. Copiá este archivo como .env y completalo.
# Si corre dentro del repo, las credenciales de Supabase se toman del .env de la raíz
# y no hace falta repetirlas acá. En la PC titular conviene tener todo en este archivo.
# Inventario de qué es cada secreto y dónde se saca: docs/OPERACION.md.

# ---------------------------------------------------------------- Red ----------
# Quién puede entrar
#   127.0.0.1 → solo esta PC (por defecto). Con Cloudflare Tunnel alcanza con esto.
#   0.0.0.0   → también otras computadoras de la red. Exige el login con el CRM.
HOST=127.0.0.1
PUERTO=3100
# on si llega por un proxy (Cloudflare Tunnel, nginx): toma de ahí el https y la IP.
WA_DETRAS_DE_PROXY=off
# Solo con la app de escritorio (Whatsapp/escritorio): token del túnel de Cloudflare
# (Zero Trust → Networks → Tunnels → el túnel → token). La app corre cloudflared con él y
# prende WA_DETRAS_DE_PROXY sola. Ver docs/ESCRITORIO.md.
# WA_TUNEL_TOKEN=

# ---------------------------------------------------------------- Login --------
# Login con los usuarios del CRM (Supabase del CRM)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Nunca en el navegador ni con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dirección del CRM. Es el único sitio que puede mostrar el panel embebido y mandarle la
# sesión, y adónde se manda al que abre el panel sin haber entrado desde el CRM.
CRM_URL=https://neifertautomotores.com/crm/whatsapp

# Quién puede hacer qué (roles del CRM: admin, dueno, vendedor), separados por coma:
#   WHATSAPP_ROLES          entran a la bandeja y escriben
#   WHATSAPP_ROLES_LINEA    además ven el QR, vinculan/desvinculan y cambian preferencias
#   WHATSAPP_ROLES_LECTURA  entran solo a mirar (no escriben ni cambian nada)
WHATSAPP_ROLES=admin,dueno,vendedor
WHATSAPP_ROLES_LINEA=admin,dueno
# WHATSAPP_ROLES_LECTURA=

# Duración de la sesión del panel, en horas
SESION_HORAS=12
# Firma de la cookie. Si no se define se genera sola y se guarda en DATA_DIR.
# SESION_SECRETO=

# ---------------------------------------------------------------- Línea --------
# Con la app de escritorio NO va acá: el número se escribe en la app (característica sin 0
# + número sin 15) y ella se lo pasa al servidor.
# Solo para correr el servidor a mano (npm start): la línea, con código de país (549…).
# Cada número tiene sus propios datos (Supabase, R2 y data/lineas/<número>); si se escanea
# el QR con otro celular, se rechaza. Sin número, los datos van a "sin-numero".
# WHATSAPP_NUMERO=5493492123456
# Versión del protocolo de WhatsApp Web, fija (ej. 2.3000.1027934701). Vacío: la última
# con la que conectó bien, o la de Baileys. Si WhatsApp la rechaza se actualiza sola.
# WA_VERSION=

# ---------------------------------------------------------------- Datos --------
# Base de datos de los mensajes (proyecto de Supabase del WhatsApp, esquema "wa").
# Supabase → Connect → Session pooler. También se acepta el nombre WA_SUPABASE_URL.
WA_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:CLAVE@aws-0-xx.pooler.supabase.com:5432/postgres

# Dónde se guardan chats, contactos y mensajes:
#   supabase → en la base de arriba (por defecto si WA_DATABASE_URL está definida)
#   local    → en archivos dentro de DATA_DIR. Solo para pruebas.
# ALMACEN=local

# Cuántos días se guardan mensajes y archivos. Todos los días se borra lo más viejo.
# WA_VENTANA_DIAS=365

# Anti-borrado (definición legal, ver docs/PRIVACIDAD.md). on: un mensaje eliminado para
# todos se conserva marcado y las ediciones guardan la versión anterior. off: como en el
# celular (el eliminado pierde el contenido, la edición pisa el texto).
WA_CONSERVAR_ELIMINADOS=on
WA_CONSERVAR_EDICIONES=on

# Carpeta de la sesión de WhatsApp, los registros, y los archivos si no hay R2.
DATA_DIR=data

# Archivos (fotos, videos, audios, stickers, documentos, fotos de perfil) en Cloudflare R2.
# El bucket tiene que ser PRIVADO; no uses el público del catálogo. Sin esta línea los
# archivos van a DATA_DIR. Ver docs/SERVIDOR.md, "Archivos en Cloudflare R2".
# WA_R2_BUCKET=neifert-whatsapp
# Endpoint y token: si no se definen, se usan los R2_* del .env del CRM.
# WA_R2_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# WA_R2_ACCESS_KEY_ID=
# WA_R2_SECRET_ACCESS_KEY=
# Tamaño máximo de archivo (MB): lo que se baja solo y lo que se puede mandar.
# WA_MEDIA_MAX_MB=64

# ---------------------------------------------------------------- Respaldo -----
# Clave para cifrar el respaldo de la sesión y de los .env en R2 (respaldo/). Con ella,
# `npm run restaurar` levanta la línea en otra PC sin escanear el QR. Guardala en un
# gestor de contraseñas: sin ella el respaldo no sirve. Larga y al azar.
# WA_BACKUP_CLAVE=

# ---------------------------------------------------------------- Alertas ------
# A quién avisar si la línea se cae, se desvincula o el celular deja de responder
# (separados por coma). Los emails salen por Resend (la misma cuenta del CRM).
# WA_ALERTA_EMAIL=dueno@neifertautomotores.com,admin@neifertautomotores.com
# RESEND_API_KEY=re_...
# WA_ALERTA_REMITENTE=Alertas Neifert <alertas@neifertautomotores.com>
# Además, o en lugar del email: POST { titulo, detalle } a esta dirección (ntfy, Telegram…).
# WA_ALERTA_WEBHOOK=
# Minutos sin conexión antes de avisar, y días sin señales del celular.
# WA_ALERTA_MINUTOS=15
# WA_ALERTA_CELULAR_DIAS=10
# Días que se guardan los registros (data/logs).
# WA_LOG_DIAS=30
