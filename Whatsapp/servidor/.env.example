# Servidor de WhatsApp de Neifert. Copiá este archivo como .env y completalo.
# Si corre dentro del repo, las credenciales de Supabase se toman del .env de la raíz
# y no hace falta repetirlas acá.

# Quién puede entrar
#   127.0.0.1 → solo esta PC (por defecto)
#   0.0.0.0   → también otras computadoras. Exige el login con el CRM.
HOST=127.0.0.1
PUERTO=3100

# Login con los usuarios del CRM (Supabase)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Solo servidor. Nunca en el navegador ni con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Adónde mandar al que abre el panel sin haber entrado desde el CRM
CRM_URL=https://neifert.com.ar/crm/whatsapp

# Roles que entran aunque no tengan la vista "whatsapp" marcada (separados por coma)
WHATSAPP_ROLES_SIEMPRE=admin,dueno

# Duración de la sesión del panel, en horas
SESION_HORAS=12
# Firma de la cookie. Si no se define se genera sola y se guarda en DATA_DIR.
# SESION_SECRETO=

# Base de datos de los mensajes (proyecto de Supabase del WhatsApp, esquema "wa").
# Supabase → Connect → Session pooler. También se acepta el nombre WA_SUPABASE_URL.
WA_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:CLAVE@aws-0-xx.pooler.supabase.com:5432/postgres

# Dónde se guardan chats, contactos y mensajes:
#   supabase → en la base de arriba (por defecto si WA_DATABASE_URL está definida)
#   local    → en archivos dentro de DATA_DIR. Solo para pruebas.
# ALMACEN=local

# Carpeta de la sesión de WhatsApp y los archivos multimedia (y de los mensajes en modo local).
DATA_DIR=data
