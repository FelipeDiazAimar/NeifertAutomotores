# =============================================================================
#  Configuración de la PC servidor — app "Neifert WhatsApp"
# =============================================================================
#  1. Copiá este archivo como "configuracion.env" (o ".env") y completalo.
#  2. En la app: "Elegir archivo…" → este archivo → "Guardar y arrancar el servidor".
#     La app lo guarda cifrado con Windows y puede borrar el original.
#  3. Pasalo SOLO por un gestor de contraseñas (Bitwarden Send, 1Password).
#     Nunca por WhatsApp, mail ni Drive. No se sube al repo (*.env está en .gitignore).
#
#  El NÚMERO DE LA LÍNEA no va acá: se escribe en la app (característica sin 0 +
#  número sin 15). Tampoco van HOST, PUERTO, DATA_DIR ni WA_DETRAS_DE_PROXY: los pone
#  la app sola.
#
#  Cada línea indica de quién es la clave y dónde se saca.
# =============================================================================


# -----------------------------------------------------------------------------
#  CRM (Supabase del CRM) — LAS PASA TU COMPAÑERO
#  Supabase → proyecto del CRM → Project Settings → API
# -----------------------------------------------------------------------------
# "Project URL"
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# "anon public"
SUPABASE_ANON_KEY=
# "service_role" (secreta: solo en este archivo, nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Dirección del CRM (fija: es el único sitio que puede mostrar el WhatsApp)
CRM_URL=https://neifertautomotores.com/crm/whatsapp


# -----------------------------------------------------------------------------
#  Base de mensajes (Supabase "Whatsapp Neifert") — TUYA
#  Supabase → proyecto "Whatsapp Neifert" → Connect → "Session pooler" → URI.
#  Reemplazá [YOUR-PASSWORD] por la contraseña de la base (si no la tenés:
#  Project Settings → Database → Reset database password).
# -----------------------------------------------------------------------------
WA_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres


# -----------------------------------------------------------------------------
#  Archivos en Cloudflare R2 — TUYA (tu cuenta de Cloudflare)
# -----------------------------------------------------------------------------
# El bucket PRIVADO del WhatsApp (no el público del catálogo)
WA_R2_BUCKET=neifert-whatsapp
# R2 → Overview → "Account ID" (o "S3 API"): https://<Account ID>.r2.cloudflarestorage.com
WA_R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
# R2 → Manage API tokens → Create API token → permiso "Object Read & Write" →
# "Apply to specific buckets only": neifert-whatsapp. Copiá estas dos AL CREARLO
# (el secreto se muestra una sola vez). El "Token value" de esa pantalla NO se usa.
WA_R2_ACCESS_KEY_ID=
WA_R2_SECRET_ACCESS_KEY=
# Tope de espacio en GB (el plan gratis incluye 10). Al 85 % se borran los archivos
# más viejos. Opcional: si no se pone, queda en 9.
WA_R2_LIMITE_GB=9


# -----------------------------------------------------------------------------
#  Cloudflare Tunnel (para que el CRM llegue a esta PC) — TUYA
#  Requiere que neifertautomotores.com esté en tu Cloudflare (hoy el DNS lo maneja
#  tu compañero en su Vercel: él cambia los nameservers o te da acceso).
#  Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared →
#  copiá SOLO el token (lo que va después de "--token"). No hace falta instalar
#  cloudflared: lo trae la app. Public Hostname: wa.neifertautomotores.com → HTTP localhost:3100
#  Mientras no esté, dejalo vacío: el servidor anda igual, solo que el CRM no llega.
# -----------------------------------------------------------------------------
WA_TUNEL_TOKEN=


# -----------------------------------------------------------------------------
#  Respaldo de la sesión — LA INVENTÁS VOS
#  Con esto, si la PC se rompe, otra PC conecta la línea sin escanear el QR.
#  Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#  Guardala también en el gestor de contraseñas: sin ella el respaldo no sirve.
#  NO la pongas en el .env de tu PC de desarrollo (se pisarían los respaldos).
# -----------------------------------------------------------------------------
WA_BACKUP_CLAVE=


# -----------------------------------------------------------------------------
#  Alertas por email (línea caída, desvinculada, celular sin señal)
# -----------------------------------------------------------------------------
# A quién avisar (los elegís vos), separados por coma
WA_ALERTA_EMAIL=
# LA PASA TU COMPAÑERO: es la de Resend del CRM (en su Vercel → Environment Variables)
RESEND_API_KEY=
# Opcional: remitente con el dominio verificado en Resend
# WA_ALERTA_REMITENTE=Alertas Neifert <alertas@neifertautomotores.com>


# -----------------------------------------------------------------------------
#  Privacidad (ver Whatsapp/docs/PRIVACIDAD.md, según lo que firme el dueño)
#  on: un mensaje "eliminado para todos" o editado se conserva. off: como el celular.
# -----------------------------------------------------------------------------
WA_CONSERVAR_ELIMINADOS=on
WA_CONSERVAR_EDICIONES=on
